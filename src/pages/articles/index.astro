---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles } from '../../lib/articles';
import { LINKS } from '../../config';

const articles = await getArticles();
const tags = [...new Set(articles.flatMap((a) => a.tags))].sort();
---
<Base
  title="Articles · Mahdee Islam"
  description="Essays by Mahdee Islam on the Qur'an's relationship with the Bible, read across Hebrew, Aramaic, Syriac and Greek sources."
  current="articles"
>
  <div class="frame">
    <section class="page column">
      <header class="head">
        <span class="label">Writing</span>
        <h1>Articles</h1>
        <p class="sub">Essays on the Qur'an and the Bible, read in their original languages.</p>
      </header>

      {articles.length > 0 ? (
        <>
          <div class="controls" role="search">
            <label class="search" for="article-search">
              <span class="visually-hidden">Search articles</span>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              <input id="article-search" type="search" placeholder="Search by title or topic" autocomplete="off" />
            </label>
            {tags.length > 0 && (
              <div class="chips" role="group" aria-label="Filter by topic">
                <button type="button" class="chip" data-tag="" aria-pressed="true">All</button>
                {tags.map((t) => <button type="button" class="chip" data-tag={t} aria-pressed="false">{t}</button>)}
              </div>
            )}
            <p class="count" id="article-count" aria-live="polite">{articles.length} {articles.length === 1 ? 'article' : 'articles'}</p>
          </div>

          <ul class="list" id="article-list">
            {articles.map((article) => <ArticleCard article={article} />)}
          </ul>
          <p class="none" id="no-results" hidden>No articles match that search. Try a different word, or choose All.</p>
        </>
      ) : (
        <p class="none">New essays will appear here soon.{LINKS.substack && <> Meanwhile, <a href={LINKS.substack}>read them on Substack</a>.</>}</p>
      )}
    </section>
  </div>
</Base>

<script>
  const input = document.getElementById('article-search') as HTMLInputElement | null;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-article]'));
  const count = document.getElementById('article-count');
  const none = document.getElementById('no-results');
  let tag = '';

  function apply() {
    const q = (input?.value ?? '').trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const matchesText = !q || (card.dataset.search ?? '').includes(q);
      const matchesTag = !tag || (card.dataset.tags ?? '').split('|').includes(tag);
      const show = matchesText && matchesTag;
      card.hidden = !show;
      if (show) shown++;
    }
    if (count) count.textContent = `${shown} ${shown === 1 ? 'article' : 'articles'}`;
    if (none) none.hidden = shown > 0;
  }

  input?.addEventListener('input', apply);
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      tag = chip.dataset.tag ?? '';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      apply();
    })
  );
</script>

<style>
  .page { display: grid; gap: 2rem; padding-block: clamp(2.5rem, 7vw, 4.5rem); }
  .head { display: grid; gap: 0.75rem; }
  h1 { font-size: var(--step-4); line-height: 1.02; letter-spacing: -0.02em; }
  .sub { font-size: var(--step-1); color: var(--muted); }

  .controls { display: grid; gap: 0.9rem; }
  .search {
    display: flex; align-items: center; gap: 0.6rem;
    border: 1px solid var(--rule); border-radius: 4px;
    padding: 0 0.85rem; background: var(--paper-raised); color: var(--muted);
  }
  .search:focus-within { border-color: var(--lapis); }
  .search input {
    flex: 1; min-width: 0; border: 0; outline: 0; background: transparent;
    font: 400 1rem/1 var(--body); color: var(--ink); padding: 0.85rem 0;
  }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    font: 500 0.8rem/1 var(--body); padding: 0.5rem 0.8rem; border-radius: 999px;
    border: 1px solid var(--rule); background: transparent; color: var(--ink); cursor: pointer;
  }
  .chip:hover { border-color: var(--lapis); }
  .chip[aria-pressed="true"] { background: var(--lapis); border-color: var(--lapis); color: var(--paper); }
  .count { font: 400 0.75rem/1.4 var(--mono); color: var(--muted); }

  .list { margin: 0; padding: 0; border-bottom: 1px solid var(--rule); }
  .none { color: var(--muted); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
