---
import '../styles/global.css';
import { SITE, LINKS } from '../config';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  jsonLd?: object;
  current?: 'home' | 'articles';
}

const {
  title = SITE.title,
  description = SITE.description,
  canonical = new URL(Astro.url.pathname, SITE.url).href,
  ogImage,
  ogType = 'website',
  jsonLd,
  current,
} = Astro.props;

const sameAs = Object.values(LINKS).filter(Boolean);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url + '/',
  jobTitle: 'Software and AI Engineer',
  homeLocation: { '@type': 'Place', name: SITE.location },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Monash University' },
  knowsAbout: ['Artificial intelligence', 'Agentic AI', 'Retrieval-augmented generation', 'Knowledge graphs', 'Business automation', "Qur'anic studies", 'Biblical studies', 'Comparative theology', 'Indoor cricket'],
  sameAs,
  ...(ogImage ? { image: ogImage } : {}),
};
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={SITE.name} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.name} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? person)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&family=Work+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&family=Noto+Naskh+Arabic:wght@500&family=Noto+Sans+Syriac:wght@500&family=Noto+Serif+Hebrew:wght@500&display=swap" />

  <script is:inline>
    try {
      const t = localStorage.getItem('theme');
      if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
    } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="frame bar">
      <a class="brand" href="/">Mahdee Islam</a>
      <nav aria-label="Main">
        <a href="/#work">Work</a>
        <a href="/#research">Research</a>
        <a href="/articles/" aria-current={current === 'articles' ? 'page' : undefined}>Articles</a>
        <button class="theme" type="button" id="theme-toggle" aria-label="Switch between light and dark mode">
          <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></g></svg>
          <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z"/></svg>
        </button>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="frame foot">
      <span>© {new Date().getFullYear()} Mahdee Islam</span>
      <span class="foot-links">
        <a href={LINKS.linkedin} rel="me">LinkedIn</a>
        <a href={LINKS.github} rel="me">GitHub</a>
        <a href={LINKS.instagram} rel="me">Instagram</a>
        {LINKS.substack && <a href={LINKS.substack} rel="me">Substack</a>}
      </span>
      <span>{SITE.location}</span>
    </div>
  </footer>

  <script>
    const root = document.documentElement;
    const button = document.getElementById('theme-toggle');
    const isDark = () =>
      root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    button?.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  </script>
</body>
</html>

<style>
  body::before {
    content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 21;
    background: var(--paper);
  }
  .site-header {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.75rem; }
  .brand { font: 600 1.15rem/1 var(--display); color: var(--ink); text-decoration: none; white-space: nowrap; }
  nav { display: flex; align-items: center; gap: clamp(0.9rem, 3vw, 1.75rem); }
  nav a { color: var(--muted); text-decoration: none; font-size: 0.95rem; }
  nav a:hover, nav a[aria-current="page"] { color: var(--ink); }
  .theme {
    display: grid; place-items: center; width: 2.25rem; height: 2.25rem;
    border: 1px solid var(--rule); border-radius: 50%; background: transparent; color: var(--ink); cursor: pointer;
  }
  .theme:hover { border-color: var(--lapis); color: var(--lapis); }
  .theme .moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme .sun { display: none; }
    :global(:root:not([data-theme="light"])) .theme .moon { display: block; }
  }
  :global(:root[data-theme="dark"]) .theme .sun { display: none; }
  :global(:root[data-theme="dark"]) .theme .moon { display: block; }
  @media (max-width: 420px) {
    nav a[href="/#research"] { display: none; }
  }

  .site-footer { border-top: 1px solid var(--rule); margin-top: 2rem; }
  .foot {
    padding-block: 1.5rem 2rem;
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem 1.5rem;
    font: 400 0.8rem/1.6 var(--mono); color: var(--muted);
  }
  .foot-links { display: flex; flex-wrap: wrap; gap: 1rem; }
</style>
