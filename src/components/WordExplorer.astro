---
// "Word" in four scriptural languages. Pick one to read about it.
const words = [
  {
    id: 'kalima',
    script: 'كَلِمَة',
    lang: 'ar',
    dir: 'rtl',
    font: 'ar',
    translit: 'kalima',
    language: 'Arabic',
    root: 'k-l-m · to speak',
    source: 'Qur’an 3:45',
    line: 'The angels give Maryam good news of “a word from Him”, whose name is the Messiah, ʿĪsā son of Maryam.',
    note: 'The Qur’an calls Jesus God’s kalima again in 4:171. Reading that title against Luke’s infancy narrative is the spine of my current research.',
  },
  {
    id: 'mellta',
    script: 'ܡܶܠܬ݂ܳܐ',
    lang: 'syc',
    dir: 'rtl',
    font: 'syr',
    translit: 'melltā',
    language: 'Syriac',
    root: 'm-l-l · to speak',
    source: 'Peshitta, John 1:1',
    line: 'The Syriac Gospel opens: “In the beginning was the melltā.”',
    note: 'Syriac was a major language of Christianity in the late antique Near East, which makes it a key witness to how the Gospel was told in the Qur’an’s world.',
  },
  {
    id: 'davar',
    script: 'דָּבָר',
    lang: 'he',
    dir: 'rtl',
    font: 'he',
    translit: 'dāḇār',
    language: 'Hebrew',
    root: 'd-b-r · to speak',
    source: 'Psalm 33:6',
    line: '“By the word of the LORD were the heavens made.”',
    note: 'Dāḇār means both “word” and “thing”: in the Hebrew Bible, what God says comes to pass.',
  },
  {
    id: 'logos',
    script: 'λόγος',
    lang: 'grc',
    dir: 'ltr',
    font: 'gr',
    translit: 'logos',
    language: 'Greek',
    root: 'legō · to say, to gather',
    source: 'John 1:14',
    line: '“And the Word was made flesh, and dwelt among us.”',
    note: 'The Greek Logos carried a long philosophical history before John used it, and that history shapes how Christians and Muslims have argued over the title since.',
  },
];
---
<div class="explorer" data-explorer>
  <div class="tabs" role="tablist" aria-label="The word for “word” in four languages">
    {words.map((w, i) => (
      <button
        role="tab"
        type="button"
        id={`tab-${w.id}`}
        aria-controls={`panel-${w.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
      >
        <span class={`w ${w.font}`} lang={w.lang} dir={w.dir}>{w.script}</span>
        <span class="cap">{w.translit} · {w.language}</span>
      </button>
    ))}
  </div>

  {words.map((w, i) => (
    <div class="panel" role="tabpanel" id={`panel-${w.id}`} aria-labelledby={`tab-${w.id}`} hidden={i !== 0}>
      <dl>
        <div><dt class="label">Root</dt><dd>{w.root}</dd></div>
        <div><dt class="label">Where it appears</dt><dd>{w.source}</dd></div>
      </dl>
      <p class="line">{w.line}</p>
      <p class="note">{w.note}</p>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-explorer]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = root.querySelector<HTMLElement>('#' + t.getAttribute('aria-controls'));
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        select(tabs[(i + step + tabs.length) % tabs.length], true);
      });
    });
  });
</script>

<style>
  .explorer { display: grid; gap: 0; }
  .tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 1px solid var(--rule);
  }
  .tabs button {
    all: unset;
    box-sizing: border-box;
    cursor: pointer;
    display: grid; gap: 0.3rem; justify-items: start;
    padding: 0.9rem 0.75rem 0.85rem;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: background-color 160ms ease;
  }
  .tabs button + button { border-left: 1px solid var(--rule); }
  .tabs button:hover { background: var(--lapis-soft); }
  .tabs button[aria-selected="true"] { border-bottom-color: var(--lapis); background: var(--lapis-soft); }
  .tabs button:focus-visible { outline: 2px solid var(--lapis); outline-offset: -2px; }
  .w { font-size: 1.7rem; line-height: 1.3; color: var(--lapis); }
  .w.ar { font-family: var(--arabic); }
  .w.syr { font-family: var(--syriac); }
  .w.he { font-family: var(--hebrew); }
  .w.gr { font-family: var(--display); font-style: italic; }
  .cap { font: 400 0.72rem/1.4 var(--mono); color: var(--muted); }

  .panel { display: grid; gap: 0.6rem; padding: 1rem 0.75rem 0.25rem; }
  dl { display: flex; flex-wrap: wrap; gap: 0.4rem 2rem; margin: 0; }
  dl div { display: grid; gap: 0.1rem; }
  dd { margin: 0; font-size: 0.9rem; }
  .line { font-family: var(--display); font-size: var(--step-1); line-height: 1.5; }
  .note { color: var(--muted); font-size: 0.92rem; }

  @media (max-width: 560px) {
    .tabs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tabs button:nth-child(3) { border-left: 0; }
    .tabs button:nth-child(n+3) { border-top: 1px solid var(--rule); }
  }
</style>
