---
import { SUMMIT_VIDEO_ID } from '../config';
const embed = `https://www.youtube-nocookie.com/embed/${SUMMIT_VIDEO_ID}?autoplay=1&mute=1&loop=1&playlist=${SUMMIT_VIDEO_ID}&playsinline=1&rel=0&modestbranding=1`;
---
<section class="summit" id="summit" aria-labelledby="summit-h">
  <div class="frame inner">
    <div class="copy">
      <span class="label">January 2025 · Bangkok</span>
      <h2 id="summit-h">4th Global Peace Summit</h2>
      <p>I represented the Monash University Islamic Society as a delegate at the 4th Global Peace Summit, held at the United Nations Conference Centre in Bangkok under the theme <em>A World Together</em>. The summit brought together 400 emerging leaders from 46 countries.</p>
      <a href={`https://www.youtube.com/watch?v=${SUMMIT_VIDEO_ID}`}>Watch on YouTube</a>
    </div>
    <div class="video">
      <iframe
        src={embed}
        title="4th Global Peace Summit 2025, United Nations Conference Centre, Bangkok"
        allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
  </div>
</section>

<style>
  .summit { background: var(--lapis-soft); }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  .copy { display: grid; gap: 0.75rem; justify-items: start; }
  .copy h2 { font-size: var(--step-3); line-height: 1.15; }
  .copy a { font-weight: 500; }
  .copy a::after { content: " →"; }
  .video {
    width: 100%; max-width: 100%; aspect-ratio: 16 / 9;
    border-radius: 6px; overflow: hidden; background: var(--ink);
  }
  .video iframe { width: 100%; height: 100%; border: 0; display: block; }
  @media (max-width: 760px) { .inner { grid-template-columns: minmax(0, 1fr); } }
</style>
